# Supabase Configuration
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key (server-side only — NEVER use NEXT_PUBLIC_ prefix)
# Found in Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Self-registration is denied unless explicitly enabled.
SUPABASE_AUTH_SIGNUP_ENABLED=false

# Instagram Graph API Configuration
# Create an app at https://developers.facebook.com/
INSTAGRAM_APP_ID=your-facebook-app-id
INSTAGRAM_APP_SECRET=your-facebook-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token-here

# Transitional auth fallback — Supabase Auth is primary; remove after operator migration
ADMIN_USER=admin
ADMIN_PASS=your-strong-password-here
# Systemd and internal cron calls authenticate with this header secret
CRON_SECRET=your-long-random-cron-secret-here
