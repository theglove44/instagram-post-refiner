[Unit]
Description=Tuckin and Talk monthly benchmark (competitor snapshots, hashtag audits)
After=network-online.target tuckinandtalk.service
Wants=network-online.target

[Service]
Type=oneshot
# Calls the monthly cron endpoint which fans out to the benchmark tasks
ExecStart=/usr/bin/curl -fsS -m 600 -H "x-cron-secret: ${TAT_CRON_SECRET}" http://localhost:3001/api/cron/monthly
EnvironmentFile=/opt/tuckinandtalk/.env.cron
User=www-data

[Install]
WantedBy=multi-user.target
