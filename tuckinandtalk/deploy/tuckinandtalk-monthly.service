[Unit]
Description=Tuckin and Talk — Monthly benchmark (competitor snapshots, hashtag audits)
After=network-online.target tuckinandtalk.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/home/christof21/instagram-post-refiner/tuckinandtalk/.env.local
ExecStart=/usr/bin/curl -sf -H "x-cron-secret: ${TAT_CRON_SECRET}" http://localhost:3001/api/cron/monthly
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
